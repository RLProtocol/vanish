# account that pays gas for deposits (and for withdrawals if you don't use a relayer)
PRIVATE_KEY=
# optional RPC overrides (public endpoints are rate limited; Alchemy etc. recommended)
RH_MAINNET_RPC=https://rpc.mainnet.chain.robinhood.com
RH_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com
LOCAL_RPC=http://127.0.0.1:8545
# relayer
RELAYER_PRIVATE_KEY=
NETWORK=rhTestnet
PORT=8000
FEE_BPS=30
# free key from https://etherscan.io/myapikey (v2 key works for robin.etherscan.io)
ETHERSCAN_API_KEY=
